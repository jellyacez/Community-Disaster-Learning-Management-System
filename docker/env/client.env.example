# ─────────────────────────────────────────────────────────────────────────────
# Client environment (Vite). Copy to client/.env.
# Vite inlines these at build time: rebuild or restart the dev server after changes.
# Every variable is described in docs/configuration.md. Never commit client/.env.
# ─────────────────────────────────────────────────────────────────────────────

# API base URL (no trailing slash). Default: http://localhost:5000/api in dev, /api in a build
VITE_API_URL=http://localhost:5000/api

# Better Auth base URL. Default: http://localhost:5000 in dev, same origin in a build
VITE_BASE_URL=http://localhost:5000

# Cloudflare Turnstile site key (required). Local development test key:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
