# ─────────────────────────────────────────────────────────────────────────────
# Server environment. Copy to server/.env and fill in the values.
# Every variable is described in docs/configuration.md. Never commit server/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Web app origin: CORS, Better Auth trusted origin, links in emails (required in production)
FRONTEND_URL=http://localhost:5173
# Base of URLs for files uploaded to local disk
BACKEND_URL=http://localhost:5000
# 1 = trust one proxy hop (behind nginx) without the rest of production mode
# TRUST_PROXY=1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Docker Compose overrides DB_HOST to "db".
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=LMS_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
# Production only: CA file for a self-signed database certificate
# DB_SSL_CA_PATH=
# Production deploy only (deploy.yml): postgresql://user:password@host:5432/dbname
# DATABASE_URL=
# Optional: pg_dump / pg_restore binaries if not on PATH
# PG_DUMP_PATH=
# PG_RESTORE_PATH=

# ── Authentication ───────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:5000
# Generate with: npm run rotate-better-auth   (format "2:<new>, 1:<old>")
BETTER_AUTH_SECRETS="2:YOUR_SECRET_1, 1:YOUR_SECRET_2"
# Single-secret alternative, used only when BETTER_AUTH_SECRETS is unset
# BETTER_AUTH_SECRET=
# Cloudflare Turnstile secret. Local development: Cloudflare's test secret
# 1x0000000000000000000000000000000AA (accepts only the dummy token; never in production)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Google sign-in is enabled only when both are set
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# true = register the twoFactor plugin and require 2FA for admin roles (restart to apply)
MFA_ENABLED=false

# ── Email (Nodemailer, Gmail) ────────────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# ── Backups and restore (System Health) ──────────────────────────────────────
# 12 to 256 bytes; locks backup ZIPs and the pre-restore safety dump
BACKUP_ZIP_PASSWORD=your_backup_zip_password
# 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=your_64_hex_character_key
# Keep false; set true only during a maintenance window, restart, and set it back afterwards.
ENABLE_DATABASE_RESTORE=false
# Optional: where the encrypted pre-restore safety dump is written (default server/backups/pre-restore-safety.dump)
# RESTORE_SAFETY_DUMP_PATH=

# ── File uploads (optional; without both keys files go to server/uploads) ────
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET_NAME=your_bucket_name
